{
  "$comment": "Allows read-only git and denies every mutating git command. Suits projects where the user performs all commits, pushes, and merges; pairs with commit-message-drafter and pr-description-drafter. Allow rules match the whole command string: run one git command per shell call, without chaining.",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git reflog*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git ls-files*)",
      "Bash(git cat-file*)",
      "Bash(git merge-base*)",
      "Bash(git describe*)",
      "Bash(git shortlog*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git remote -v)",
      "Bash(git config --get*)",
      "Bash(git config --list*)",
      "Bash(git fetch*)"
    ],
    "deny": [
      "Bash(git add*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git merge *)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git stash*)",
      "Bash(git tag*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(git branch -c*)",
      "Bash(git branch -f*)",
      "Bash(git branch --delete*)",
      "Bash(git branch --move*)",
      "Bash(git branch --force*)",
      "Bash(git remote add*)",
      "Bash(git remote remove*)",
      "Bash(git remote rm*)",
      "Bash(git remote set-url*)",
      "Bash(git remote rename*)",
      "Bash(git config --global*)",
      "Bash(git config --unset*)",
      "Bash(git config --replace-all*)",
      "Bash(git config user.*)",
      "Bash(git init*)",
      "Bash(git clone*)",
      "Bash(git submodule*)",
      "Bash(git apply*)",
      "Bash(git am*)",
      "Bash(git gc*)",
      "Bash(git worktree*)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref*)",
      "Bash(git symbolic-ref*)",
      "Bash(git notes*)",
      "Bash(git bisect*)"
    ]
  }
}
