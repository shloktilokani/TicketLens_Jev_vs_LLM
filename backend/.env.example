# Backend environment variables
APP_ENV=development
APP_NAME=TicketLens
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Local MongoDB Community Edition
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=ticketlens

# Provider credentials (backend only; never commit a real .env)
TYPESAFE_API_KEY=
OPENAI_API_KEY=

# Provider models
JEV_MODEL=jev-latest
OPENAI_MODEL=

# Request behavior
PROVIDER_TIMEOUT_SECONDS=45
BULK_CONCURRENCY=2
JEV_ESCALATION_THRESHOLD=0.5

# Optional: set explicit logging level
LOG_LEVEL=INFO
