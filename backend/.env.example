# Backend environment variables
APP_ENV=development
APP_NAME=TicketLens
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Local MongoDB Community Edition
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=ticketlens

# Provider credentials (backend only; never commit a real .env)
TYPESAFE_API_KEY=
OPENAI_API_KEY=

# Jev side: TypeSafe's hosted API (needs TYPESAFE_API_KEY), or a local System One server.
# Local AutoTrust JEV through Ollama: JEV_BASE_URL=http://127.0.0.1:11434 and JEV_MODEL=autotrust-jev:9b
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# LLM side: ollama (local, no key) or openai (needs OPENAI_API_KEY and OPENAI_MODEL)
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_MODEL=

# Request behavior
PROVIDER_TIMEOUT_SECONDS=45
BULK_CONCURRENCY=2
JEV_ESCALATION_THRESHOLD=0.5

# Use built-in fake Jev and GPT providers: no API calls, no cost. Results are labelled mock-*.
MOCK_PROVIDERS=false
# Fake thinking time in seconds for the mock providers (Jev this long, GPT twice as long).
MOCK_DELAY_SECONDS=1.5

# Optional: set explicit logging level
LOG_LEVEL=INFO
