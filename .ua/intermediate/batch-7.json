      "id": "config:.mcp.json",
      "type": "config",
      "name": ".mcp.json",
      "filePath": ".mcp.json",
      "summary": "Project-scoped MCP server configuration that launches version-pinned Playwright and Chrome DevTools servers against an isolated Chrome for Testing binary. It limits Playwright to the local frontend and backend origins and turns off DevTools usage statistics and CrUX lookups while redacting network headers.",
      "tags": [
        "configuration",
        "mcp",
        "browser-automation",
        "ui-testing",
        "security"
      ],
      "complexity": "simple"
    },
    {
      "id": "document:AGENTS.md",
      "type": "document",
      "name": "AGENTS.md",
      "filePath": "AGENTS.md",
      "summary": "Operating instructions for autonomous coding agents, covering required spec reading order, autonomy expectations, technical guardrails, per-phase definition of done, developer-experience deliverables, and scope exclusions. Its guardrails fix key rules such as server-side secrets, a shared taxonomy, withholding ground-truth labels from models, and bounded retries.",
      "tags": [
        "documentation",
        "agent-instructions",
        "guardrails",
        "development",
        "scope"
      ],
      "complexity": "moderate"
    },
    {
      "id": "document:CLAUDE.md",
      "type": "document",
      "name": "CLAUDE.md",
      "filePath": "CLAUDE.md",
      "summary": "Claude Code entry-point instructions that pull in AGENTS.md, point to the progress and build-order documents, and list the backend and frontend test, lint, and build commands. It also sets the rules for the engineering skills library, including routing, security, and which actions need owner approval.",
      "tags": [
        "documentation",
        "agent-instructions",
        "development",
        "entry-point",
        "skills-routing"
      ],
      "complexity": "simple",
      "languageNotes": "The @AGENTS.md line is Claude Code memory-import syntax, which loads the referenced file as part of these instructions."
    },
    {
      "id": "document:README.md",
      "type": "document",
      "name": "README.md",
      "filePath": "README.md",
      "summary": "Project overview for the single-user ShopKart ticket classification demo comparing Jev with a configurable GPT model, including a documentation map, stack summary, and local-first scope boundary. Its run guide covers MongoDB, backend, and frontend startup, Ollama-based local models, mock providers, health checks, and test-run reports.",
      "tags": [
        "documentation",
        "entry-point",
        "overview",
        "getting-started",
        "local-development"
      ],
      "complexity": "moderate"
    }
  ],
